{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chat agent with web search, deterministic time + memory resolution",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "test": "tsx --test evals/context.test.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.17",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
