# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: https://app.tavily.com/ (free tier is enough)
TAVILY_API_KEY=

# Optional
# MODEL=gpt-4.1
# PORT=3000
# DEFAULT_TZ=Asia/Kolkata   # falls back to the system timezone
# REASONING_EFFORT=low      # lower latency on reasoning models (e.g. Gemini 3.x); leave unset for gpt-4.1
